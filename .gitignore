# =====================
# Large binary docs
# (tracked via Documentation/ folder locally;
#  too large for GitHub free tier — use Git LFS or exclude)
# =====================
Documentation/*.docx
Documentation/*.docm
Documentation/*.pptx
Documentation/*.pdf
Documentation/generators/
frontend/public/documentation/*.docx
frontend/public/documentation/*.pptx
frontend/public/documentation/*.pdf


{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Django Backend",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/Backend/flowtrack/manage.py",
      "args": ["runserver", "127.0.0.1:8000", "--noreload"],
      "django": true,
      "cwd": "${workspaceFolder}/Backend/flowtrack",
      "python": "${workspaceFolder}/Backend/flowtrack/venv/Scripts/python.exe"
    }
  ]
}

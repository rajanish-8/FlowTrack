{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start FlowTrack (Full Stack)",
      "dependsOn": [
        "Start Backend (Django)",
        "Start Frontend (Vite)"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Start Backend (Django)",
      "type": "shell",
      "command": "${workspaceFolder}/Backend/flowtrack/venv/Scripts/python.exe",
      "args": ["manage.py", "runserver", "127.0.0.1:8000"],
      "options": {
        "cwd": "${workspaceFolder}/Backend/flowtrack"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "flowtrack-servers",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Start Frontend (Vite)",
      "type": "shell",
      "command": "npm.cmd",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "flowtrack-servers",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Stop FlowTrack",
      "type": "shell",
      "command": "${workspaceFolder}/stop.bat",
      "problemMatcher": []
    }
  ]
}

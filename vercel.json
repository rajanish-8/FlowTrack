{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix frontend install && python -m pip install -r requirements.txt",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/signup/",
      "dest": "/api/index.py"
    },
    {
      "src": "/login/",
      "dest": "/api/index.py"
    },
    {
      "src": "/kanban-board/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/user-role/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/users/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/projects/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/tasks/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
